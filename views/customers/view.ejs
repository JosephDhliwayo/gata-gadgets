<%- include('../partials/header') %>
<div class="page-header">
  <div>
    <h1><%= customer.name %></h1>
    <p class="subtitle"><%= customer.phone || 'No phone on file' %></p>
  </div>
  <span class="pill pill-<%= customer.tier.toLowerCase() %>" style="font-size:0.85rem;"><%= customer.tier === 'Pending' ? 'Not Yet Eligible' : customer.tier + ' Member' %></span>
</div>

<div class="grid grid-4">
  <div class="stat"><div class="label">Loyalty Points</div><div class="value accent"><%= customer.points %></div></div>
  <div class="stat"><div class="label">Net Amount Spent</div><div class="value">$<%= customer.net_spent.toFixed(2) %></div></div>
  <div class="stat"><div class="label">Purchases</div><div class="value"><%= customer.purchase_count %></div></div>
  <div class="stat"><div class="label">Active Months</div><div class="value"><%= customer.months_active %></div></div>
</div>

<% if (customer.tier === 'Pending') { %>
  <div class="card">
    <h3 class="mt-0">Not Yet Eligible for Points</h3>
    <p>A customer starts earning loyalty points once their purchases have contributed at least <strong>$500</strong> in profit to the business.</p>
    <table>
      <tbody>
        <tr><td>Profit contributed so far</td><td class="num">$<%= customer.profit_contribution.toFixed(2) %></td></tr>
        <tr><td>Required to become eligible</td><td class="num">$500.00</td></tr>
        <tr style="font-weight:700; border-top:2px solid var(--border);">
          <td>Remaining</td>
          <td class="num">$<%= Math.max(0, 500 - customer.profit_contribution).toFixed(2) %></td>
        </tr>
      </tbody>
    </table>
  </div>
<% } else { %>
  <div class="card">
    <h3 class="mt-0">Points Breakdown</h3>
    <p class="muted" style="margin-top:-8px;">Eligible since contributing $<%= customer.profit_contribution.toFixed(2) %> in profit (required: $500.00).</p>
    <table>
      <tbody>
        <tr><td>Base points (1 per $1 net spent)</td><td class="num"><%= Math.max(0, Math.floor(customer.net_spent)) %></td></tr>
        <tr><td>Quality bonus (large-basket purchases)</td><td class="num">+<%= customer.quality_bonus %></td></tr>
        <tr><td>Regularity bonus (<%= customer.months_active %> active month<%= customer.months_active === 1 ? '' : 's' %>)</td><td class="num">+<%= customer.regularity_bonus %></td></tr>
        <tr style="font-weight:700; border-top:2px solid var(--border);"><td>Total Points</td><td class="num"><%= customer.points %></td></tr>
      </tbody>
    </table>
  </div>
<% } %>

<div class="card">
  <h3 class="mt-0">Purchase History</h3>
  <div class="table-wrap">
  <table>
    <thead><tr><th>Receipt #</th><th>Date</th><th>Cashier</th><th class="num">Total</th><th>Status</th></tr></thead>
    <tbody>
      <% receipts.forEach(r => { %>
        <tr>
          <td><a href="/receipts/<%= r.id %>"><%= r.receipt_number %></a></td>
          <td><%= formatDateTime(r.created_at) %></td>
          <td><%= r.cashier_name %></td>
          <td class="num">$<%= r.total.toFixed(2) %></td>
          <td><span class="pill <%= r.status === 'void' ? 'pill-danger' : 'pill-success' %>"><%= r.status %></span></td>
        </tr>
      <% }) %>
      <% if (receipts.length === 0) { %><tr><td colspan="5" class="muted">No purchases yet.</td></tr><% } %>
    </tbody>
  </table>
  </div>
</div>

<div class="actions-row no-print">
  <a class="btn outline" href="/customers">Back to Loyalty Program</a>
</div>
<%- include('../partials/footer') %>
