<%- include('../partials/header') %>
<div class="page-header">
  <div>
    <h1>Customer Loyalty</h1>
    <p class="subtitle">Points blend total amount spent, purchase regularity (active months), and purchase quality (large-basket bonus). A customer must have contributed at least $500 in profit before they start earning points.</p>
  </div>
</div>

<div class="grid grid-4">
  <div class="stat">
    <div class="label">Pending</div>
    <div class="value"><%= tierCounts.Pending %></div>
    <div class="muted" style="font-size:0.78rem; margin-top:2px;">under $500 profit contributed</div>
  </div>
  <% TIERS.slice().reverse().forEach(t => { %>
    <div class="stat">
      <div class="label"><%= t.name %></div>
      <div class="value accent"><%= tierCounts[t.name] %></div>
      <div class="muted" style="font-size:0.78rem; margin-top:2px;"><%= t.min %>+ pts</div>
    </div>
  <% }) %>
</div>

<div class="card">
  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Customer</th><th>Phone</th><th>Tier</th><th class="num">Points</th>
        <th class="num">Purchases</th><th class="num">Net Spent</th><th>Last Purchase</th>
      </tr>
    </thead>
    <tbody>
      <% customers.forEach(c => { %>
        <tr>
          <td><a href="/customers/<%= c.id %>"><%= c.name %></a></td>
          <td><%= c.phone || '-' %></td>
          <td><span class="pill pill-<%= c.tier.toLowerCase() %>"><%= c.tier %></span></td>
          <td class="num"><%= c.points %></td>
          <td class="num"><%= c.purchase_count %></td>
          <td class="num">$<%= c.net_spent.toFixed(2) %></td>
          <td><%= c.last_purchase_at ? formatDateTime(c.last_purchase_at) : '-' %></td>
        </tr>
      <% }) %>
      <% if (customers.length === 0) { %>
        <tr><td colspan="7" class="muted">No customers yet — a customer profile is created automatically the first time a phone number is entered on a receipt.</td></tr>
      <% } %>
    </tbody>
  </table>
  </div>
</div>
<%- include('../partials/footer') %>
