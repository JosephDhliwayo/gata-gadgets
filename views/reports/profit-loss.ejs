<%- include('../partials/header') %>
<div class="page-header no-print">
  <div>
    <h1>Profit &amp; Loss Statement</h1>
    <p class="subtitle">Revenue, cost of goods sold, and operating expenses.</p>
  </div>
  <button class="btn outline" onclick="window.print()">Print</button>
</div>

<div class="card no-print">
  <form method="GET" action="/reports/profit-loss" class="form-row" style="margin-bottom:0;">
    <div class="field"><label for="from">From</label><input type="date" id="from" name="from" value="<%= from %>"></div>
    <div class="field"><label for="to">To</label><input type="date" id="to" name="to" value="<%= to %>"></div>
    <div class="field" style="flex:0; align-self:flex-end;"><button class="btn secondary" type="submit">Run Report</button></div>
  </form>
</div>

<p class="muted">Period: <%= formatDate(from) %> to <%= formatDate(to) %></p>

<div class="card" style="max-width:640px;">
  <div class="table-wrap">
  <table>
    <tbody>
      <tr><td>Gross Sales Revenue</td><td class="num">$<%= grossRevenue.toFixed(2) %></td></tr>
      <tr><td>Less: Sales Returns</td><td class="num">-$<%= salesReturns.toFixed(2) %></td></tr>
      <tr style="font-weight:600; border-top:1px solid var(--border);">
        <td>Net Sales Revenue</td><td class="num">$<%= revenue.toFixed(2) %></td>
      </tr>
      <tr><td>Cost of Goods Sold (COGS)</td><td class="num">-$<%= cogs.toFixed(2) %></td></tr>
      <tr style="font-weight:700; border-top:2px solid var(--border);">
        <td>Gross Profit</td><td class="num">$<%= grossProfit.toFixed(2) %></td>
      </tr>
      <tr><td colspan="2" style="padding-top:16px; font-weight:600;">Operating Expenses</td></tr>
      <% expensesByCategory.forEach(e => { %>
        <tr><td style="padding-left:16px;"><%= e.category %></td><td class="num">-$<%= e.total.toFixed(2) %></td></tr>
      <% }) %>
      <% if (expensesByCategory.length === 0) { %>
        <tr><td style="padding-left:16px;" class="muted">No expenses recorded</td><td class="num">$0.00</td></tr>
      <% } %>
      <tr style="font-weight:600;"><td>Total Expenses</td><td class="num">-$<%= totalExpenses.toFixed(2) %></td></tr>
      <tr style="font-weight:800; font-size:1.1rem; border-top:2px solid var(--navy);">
        <td>Net Profit</td>
        <td class="num" style="color: <%= netProfit >= 0 ? 'var(--success)' : 'var(--danger)' %>;">$<%= netProfit.toFixed(2) %></td>
      </tr>
    </tbody>
  </table>
  </div>
</div>

<%- include('../partials/footer') %>
