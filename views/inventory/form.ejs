<%- include('../partials/header') %>
<div class="page-header">
  <h1><%= title %></h1>
</div>

<div class="card" style="max-width:640px;">
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <form method="POST" action="<%= product && product.id ? '/inventory/' + product.id : '/inventory' %>">
    <div class="form-row">
      <div class="field">
        <label for="sku">SKU</label>
        <input type="text" id="sku" name="sku" value="<%= product ? product.sku || '' : '' %>" required>
      </div>
      <div class="field">
        <label for="name">Product Name</label>
        <input type="text" id="name" name="name" value="<%= product ? product.name || '' : '' %>" required>
      </div>
    </div>
    <div class="field">
      <label for="category">Category</label>
      <input type="text" id="category" name="category" list="categories-datalist" value="<%= product ? product.category || '' : '' %>" placeholder="Choose an existing category or type a new one" autocomplete="off">
      <datalist id="categories-datalist">
        <% categories.forEach(c => { %><option value="<%= c %>"></option><% }) %>
      </datalist>
    </div>
    <div class="form-row">
      <div class="field">
        <label for="cost_price">Cost Price ($)</label>
        <input type="number" step="0.01" min="0" id="cost_price" name="cost_price" value="<%= product ? product.cost_price || 0 : 0 %>" required>
      </div>
      <div class="field">
        <label for="selling_price">Selling Price ($)</label>
        <input type="number" step="0.01" min="0" id="selling_price" name="selling_price" value="<%= product ? product.selling_price || 0 : 0 %>" required>
      </div>
    </div>
    <div class="form-row">
      <% if (!(product && product.id)) { %>
      <div class="field">
        <label for="quantity">Initial Quantity</label>
        <input type="number" min="0" id="quantity" name="quantity" value="<%= product ? product.quantity || 0 : 0 %>">
      </div>
      <% } %>
      <div class="field">
        <label for="reorder_level">Reorder Level</label>
        <input type="number" min="0" id="reorder_level" name="reorder_level" value="<%= product ? product.reorder_level || 5 : 5 %>">
      </div>
    </div>
    <div class="actions-row">
      <button class="btn" type="submit">Save Product</button>
      <a class="btn outline" href="/inventory">Cancel</a>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
