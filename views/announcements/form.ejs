<%- include('../partials/header') %>
<div class="page-header"><h1><%= title %></h1></div>
<div class="card" style="max-width:640px;">
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <form method="POST" action="/announcements">
    <div class="field">
      <label for="title">Title</label>
      <input type="text" id="title" name="title" value="<%= formData ? formData.title || '' : '' %>" required>
    </div>
    <div class="field">
      <label for="body">Message</label>
      <textarea id="body" name="body" rows="6" required><%= formData ? formData.body || '' : '' %></textarea>
    </div>
    <div class="actions-row">
      <button class="btn" type="submit">Post Announcement</button>
      <a class="btn outline" href="/announcements">Cancel</a>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
