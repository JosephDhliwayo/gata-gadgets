<%- include('../partials/header') %>
<div class="page-header">
  <div>
    <h1>Announcements</h1>
    <p class="subtitle">Company-wide updates from management.</p>
  </div>
  <% if (currentUser.role === 'admin') { %>
    <a class="btn" href="/announcements/new">+ New Announcement</a>
  <% } %>
</div>

<% announcements.forEach(a => { %>
  <div class="card announcement-card <%= a.is_read ? '' : 'unread' %>">
    <div class="page-header" style="margin-bottom:8px;">
      <div>
        <h3 class="mt-0" style="margin-bottom:2px;"><%= a.title %></h3>
        <div class="announcement-meta">By <%= a.posted_by_name %> &middot; <%= formatDateTime(a.created_at) %></div>
      </div>
      <% if (currentUser.role === 'admin') { %>
        <form method="POST" action="/announcements/<%= a.id %>/delete" onsubmit="return confirm('Delete this announcement?');">
          <button class="btn small danger" type="submit">Delete</button>
        </form>
      <% } %>
    </div>
    <p style="white-space:pre-wrap; margin:0;"><%= a.body %></p>
  </div>
<% }) %>
<% if (announcements.length === 0) { %>
  <div class="card"><p class="muted">No announcements yet.</p></div>
<% } %>
<%- include('../partials/footer') %>
