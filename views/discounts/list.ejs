<%- include('../partials/header') %>
<div class="page-header">
  <div>
    <h1>Discounts</h1>
    <p class="subtitle"><%= isAdmin ? 'Below-catalog-price sales given across the business.' : 'Discounts you have given on sales.' %></p>
  </div>
</div>

<div class="card">
  <div class="actions-row" style="margin-top:0;">
    <a class="btn small <%= status === '' ? 'secondary' : 'outline' %>" href="/discounts">All</a>
    <a class="btn small <%= status === 'pending' ? 'secondary' : 'outline' %>" href="/discounts?status=pending">Pending</a>
    <a class="btn small <%= status === 'approved' ? 'secondary' : 'outline' %>" href="/discounts?status=approved">Approved</a>
    <a class="btn small <%= status === 'rejected' ? 'secondary' : 'outline' %>" href="/discounts?status=rejected">Rejected</a>
  </div>
</div>

<div class="card">
  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Receipt #</th><% if (isAdmin) { %><th>Cashier</th><% } %>
        <th>Details</th><th class="num">Discount</th><th>Status</th><th>Reviewed</th>
        <% if (isAdmin) { %><th class="no-print"></th><% } %>
      </tr>
    </thead>
    <tbody>
      <% requests.forEach(r => { %>
        <tr>
          <td><a href="/receipts/<%= r.receipt_id %>"><%= r.receipt_number %></a></td>
          <% if (isAdmin) { %><td><%= r.requested_by_name %></td><% } %>
          <td style="white-space:pre-wrap; font-size:0.85rem;"><%= r.details || '-' %></td>
          <td class="num">$<%= r.discount_amount.toFixed(2) %></td>
          <td>
            <span class="pill <%= r.status === 'approved' ? 'pill-success' : (r.status === 'rejected' ? 'pill-danger' : 'pill-warning') %>">
              <%= r.status %>
            </span>
          </td>
          <td>
            <% if (r.status !== 'pending') { %>
              <%= r.reviewed_by_name %><br><span class="muted"><%= formatDateTime(r.reviewed_at) %></span>
              <% if (r.review_note) { %><br><span class="muted"><%= r.review_note %></span><% } %>
            <% } else { %>-<% } %>
          </td>
          <% if (isAdmin) { %>
            <td class="no-print">
              <% if (r.status === 'pending') { %>
                <form method="POST" action="/discounts/<%= r.id %>/approve" style="display:inline;" onsubmit="return confirm('Approve this discount? It will be recorded as an authorized discount.');">
                  <button class="btn small secondary" type="submit">Approve</button>
                </form>
                <form method="POST" action="/discounts/<%= r.id %>/reject" style="display:inline;" onsubmit="return confirm('Reject this discount?');">
                  <button class="btn small danger" type="submit">Reject</button>
                </form>
              <% } %>
            </td>
          <% } %>
        </tr>
      <% }) %>
      <% if (requests.length === 0) { %>
        <tr><td colspan="<%= isAdmin ? 7 : 5 %>" class="muted">No discount requests found.</td></tr>
      <% } %>
    </tbody>
  </table>
  </div>
</div>
<%- include('../partials/footer') %>
