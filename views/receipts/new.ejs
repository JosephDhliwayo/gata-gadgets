<%- include('../partials/header') %>
<div class="page-header">
  <h1>New Receipt</h1>
</div>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<% if (products.length === 0) { %>
  <div class="alert alert-warning">No products are currently in stock. Ask an administrator to add inventory before capturing a receipt.</div>
<% } else { %>

<datalist id="products-datalist">
  <% products.forEach(p => { %>
    <option value="<%= p.name %> (<%= p.sku %>)"></option>
  <% }) %>
</datalist>
<datalist id="customer-names-datalist">
  <% customers.forEach(c => { %><option value="<%= c.name %>"></option><% }) %>
</datalist>
<datalist id="customer-phones-datalist">
  <% customers.forEach(c => { %><option value="<%= c.phone %>"></option><% }) %>
</datalist>
<datalist id="courier-destinations-datalist">
  <% courierDestinations.forEach(d => { %><option value="<%= d %>"></option><% }) %>
</datalist>

<script id="products-data" type="application/json"><%- JSON.stringify(products.map(p => ({
  key: `${p.name} (${p.sku})`, id: p.id, price: p.selling_price, stock: p.quantity
}))).replace(/<\/script/gi, '<\\/script') %></script>
<script id="customers-data" type="application/json"><%- JSON.stringify(customers).replace(/<\/script/gi, '<\\/script') %></script>

<form method="POST" action="/receipts">
  <div class="card">
    <h3 class="mt-0">Customer Details</h3>
    <div class="form-row">
      <div class="field">
        <label for="customer_name">Customer Name (optional)</label>
        <input type="text" id="customer_name" name="customer_name" list="customer-names-datalist" placeholder="Search or type a name" value="<%= formData ? (formData.customer_name || '') : '' %>">
      </div>
      <div class="field">
        <label for="customer_phone">Phone (required)</label>
        <input type="tel" id="customer_phone" name="customer_phone" list="customer-phones-datalist" placeholder="Search or type a phone number" required value="<%= formData ? (formData.customer_phone || '') : '' %>">
        <div id="loyalty-hint" class="muted" style="font-size:0.8rem; margin-top:4px; display:none;"></div>
      </div>
    </div>
  </div>

  <div class="card">
    <h3 class="mt-0">Items</h3>
    <p class="muted" style="margin-top:-6px;">Search by product name or SKU. To give a negotiated price, enter a Discount amount — the catalog price itself is fixed.</p>
    <div class="line-item-row muted" style="font-size:0.78rem; text-transform:uppercase; font-weight:600;">
      <div>Product</div><div>Qty</div><div>Catalog Price</div><div>Discount</div><div>Line Total</div><div></div>
    </div>
    <div id="line-items">
      <% const initialLines = (lines && lines.length > 0) ? lines : [{}]; %>
      <% initialLines.forEach(line => { %>
        <% const prod = line.product_id ? products.find(p => String(p.id) === String(line.product_id)) : null; %>
        <% const discountValue = (prod && line.unit_price !== undefined && line.unit_price !== '') ? Math.max(0, Math.round((prod.selling_price - parseFloat(line.unit_price)) * 100) / 100) : ''; %>
        <div class="line-item-row">
          <div>
            <input type="text" class="product-search" list="products-datalist" placeholder="Search product..." autocomplete="off" required value="<%= prod ? `${prod.name} (${prod.sku})` : '' %>">
            <input type="hidden" name="product_id" class="product-id-input" value="<%= line.product_id || '' %>">
            <div class="product-hint muted" style="font-size:0.75rem; margin-top:2px;"><%= prod ? `${prod.quantity} in stock` : '' %></div>
          </div>
          <div><input type="number" name="quantity" class="qty-input" min="1" value="<%= line.quantity || 1 %>" <%= prod ? `max="${prod.quantity}"` : '' %> required></div>
          <div><input type="text" class="catalog-price-display" readonly value="<%= prod ? `$${prod.selling_price.toFixed(2)}` : '' %>" placeholder="-"></div>
          <div><input type="number" class="discount-input" step="0.01" min="0" placeholder="0.00" value="<%= discountValue %>" <%= prod ? `max="${prod.selling_price}"` : 'disabled' %>></div>
          <div class="line-total">-</div>
          <div><button type="button" class="btn small outline remove-line-btn">&times;</button></div>
          <input type="hidden" name="unit_price" class="price-input" value="<%= line.unit_price || '' %>">
        </div>
      <% }) %>
    </div>
    <button type="button" class="btn small secondary" id="add-line-btn">+ Add Item</button>

    <template id="line-item-template">
      <div class="line-item-row">
        <div>
          <input type="text" class="product-search" list="products-datalist" placeholder="Search product..." autocomplete="off" required>
          <input type="hidden" name="product_id" class="product-id-input">
          <div class="product-hint muted" style="font-size:0.75rem; margin-top:2px;"></div>
        </div>
        <div><input type="number" name="quantity" class="qty-input" min="1" value="1" required></div>
        <div><input type="text" class="catalog-price-display" readonly placeholder="-"></div>
        <div><input type="number" class="discount-input" step="0.01" min="0" placeholder="0.00" disabled></div>
        <div class="line-total">-</div>
        <div><button type="button" class="btn small outline remove-line-btn">&times;</button></div>
        <input type="hidden" name="unit_price" class="price-input">
      </div>
    </template>

    <div style="max-width:280px; margin-left:auto; margin-top:20px;">
      <table class="totals">
        <tr><td>Subtotal</td><td class="text-right" id="subtotal-display">$0.00</td></tr>
        <tr><td class="grand">Total</td><td class="text-right grand" id="total-display">$0.00</td></tr>
      </table>
    </div>
  </div>

  <div class="card">
    <h3 class="mt-0">Payment</h3>
    <div class="field">
      <label>Payment Method(s)</label>
      <p class="muted" style="margin:2px 0 8px; font-size:0.8rem;">A customer can split one sale across two or more payment methods — just add another row and enter each portion.</p>
      <div id="payment-rows">
        <% const paymentMethodOptions = [
          ['cash', 'Cash'], ['bank_transfer', 'Bank Transfer'], ['ecocash_usd', 'Ecocash USD'], ['courier', 'Courier']
        ]; %>
        <% const initialPayments = (payments && payments.length > 0) ? payments : [{ payment_method: 'cash', amount: '' }]; %>
        <% initialPayments.forEach((p, i) => { %>
          <div class="payment-row">
            <div>
              <% if (i === 0) { %><label style="font-size:0.75rem;">Method</label><% } %>
              <select name="payment_method" class="payment-method-select">
                <% paymentMethodOptions.forEach(([val, label]) => { %>
                  <option value="<%= val %>" <%= p.payment_method === val ? 'selected' : '' %>><%= label %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <% if (i === 0) { %><label style="font-size:0.75rem;">Amount</label><% } %>
              <input type="number" name="payment_amount" class="payment-amount-input" step="0.01" min="0" placeholder="0.00" value="<%= p.amount || '' %>">
            </div>
            <div><button type="button" class="btn small outline remove-payment-btn">&times;</button></div>
          </div>
        <% }) %>
      </div>
      <button type="button" class="btn small secondary" id="add-payment-btn">+ Add Payment Method</button>
      <div id="payment-summary" class="muted" style="font-size:0.85rem; margin-top:8px;"></div>
      <div id="courier-hint" class="muted" style="font-size:0.8rem; margin-top:4px; display:none; color:var(--warning);">
        Courier is a credit sale — the courier portion goes out now, and shows as an outstanding trade receivable until an admin marks it collected.
      </div>
    </div>
    <div class="field" id="courier-destination-field" style="display:none;">
      <label for="courier_destination">Courier Destination</label>
      <input type="text" id="courier_destination" name="courier_destination" list="courier-destinations-datalist" placeholder="Search or type a destination" value="<%= formData ? (formData.courier_destination || '') : '' %>">
    </div>

    <template id="payment-row-template">
      <div class="payment-row">
        <div>
          <select name="payment_method" class="payment-method-select">
            <option value="cash">Cash</option>
            <option value="bank_transfer">Bank Transfer</option>
            <option value="ecocash_usd">Ecocash USD</option>
            <option value="courier">Courier</option>
          </select>
        </div>
        <div>
          <input type="number" name="payment_amount" class="payment-amount-input" step="0.01" min="0" placeholder="0.00">
        </div>
        <div><button type="button" class="btn small outline remove-payment-btn">&times;</button></div>
      </div>
    </template>

    <div style="max-width:280px; margin-top:20px;">
      <div id="cash-fields" class="field">
        <label for="cash_received">Cash Received</label>
        <input type="number" id="cash_received" name="cash_received" step="0.01" min="0" placeholder="0.00" value="<%= formData && formData.cash_received ? formData.cash_received : '' %>">
      </div>
      <table class="totals" id="change-row" style="display:none;">
        <tr><td class="grand">Change Due</td><td class="text-right grand" id="change-display">$0.00</td></tr>
      </table>
      <p id="cash-shortfall" class="muted" style="color:var(--danger); display:none; margin-top:4px;">Cash received is less than the total due.</p>
    </div>
  </div>

  <div class="actions-row">
    <button class="btn" type="submit">Save Receipt</button>
    <a class="btn outline" href="<%= currentUser.role === 'admin' ? '/' : '/returns' %>">Cancel</a>
  </div>
</form>

<script src="/js/receipt.js"></script>
<script src="/js/loyalty-lookup.js"></script>
<% } %>
<%- include('../partials/footer') %>
